# ============================================================================
# SAFIRE — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
#
# All values marked <REPLACE_ME> MUST be replaced before use.
# Do not run the application with placeholder values.
# ============================================================================

# ---- Application ----
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Database (PostgreSQL + pgvector) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safire
POSTGRES_USER=<REPLACE_ME>
POSTGRES_PASSWORD=<REPLACE_ME>

# Full connection string (used by backend)
DATABASE_URL=postgresql://<REPLACE_ME>:<REPLACE_ME>@localhost:5432/safire

# ---- Security ----
SECRET_KEY=<REPLACE_ME>
